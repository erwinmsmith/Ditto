{
  "name": "@ditto/core",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight Node-native Agent runtime with extensible Workers and location-independent graphs.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js"
    },
    "./worker": {
      "types": "./dist/worker/index.d.ts",
      "import": "./dist/worker/index.js"
    },
    "./worker/memory": {
      "types": "./dist/worker/memory/index.d.ts",
      "import": "./dist/worker/memory/index.js"
    },
    "./worker/context": {
      "types": "./dist/worker/context/index.d.ts",
      "import": "./dist/worker/context/index.js"
    },
    "./worker/infer": {
      "types": "./dist/worker/infer/index.d.ts",
      "import": "./dist/worker/infer/index.js"
    },
    "./worker/infer/providers": {
      "types": "./dist/worker/infer/providers/index.d.ts",
      "import": "./dist/worker/infer/providers/index.js"
    },
    "./worker/interaction": {
      "types": "./dist/worker/interaction/index.d.ts",
      "import": "./dist/worker/interaction/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/sandbox": {
      "types": "./dist/runtime/sandbox/index.d.ts",
      "import": "./dist/runtime/sandbox/index.js"
    },
    "./worker/node": {
      "types": "./dist/worker/node.d.ts",
      "import": "./dist/worker/node.js"
    },
    "./worker/retrieval": {
      "types": "./dist/worker/retrieval/index.d.ts",
      "import": "./dist/worker/retrieval/index.js"
    },
    "./worker/retrieval/adapters/memory": {
      "types": "./dist/worker/retrieval/adapters/memory.d.ts",
      "import": "./dist/worker/retrieval/adapters/memory.js"
    },
    "./worker/retrieval/adapters/context": {
      "types": "./dist/worker/retrieval/adapters/context.d.ts",
      "import": "./dist/worker/retrieval/adapters/context.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean.ts dist && tsc -p tsconfig.build.json",
    "build:test": "node scripts/clean.ts .test-dist && tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:test && node --test --test-isolation=none .test-dist/test/*.test.js",
    "check": "npm run typecheck && npm test",
    "check:infer:live": "npm run build && node --env-file=.env scripts/check-infer-live.ts",
    "example:agent": "npm run build && node examples/graph-loop-worker.ts",
    "example:tools": "npm run build && node examples/interaction-tools.ts",
    "check:interaction:mcp:live": "npm run build && node scripts/check-interaction-mcp-live.mjs",
    "check:interaction:web-search:live": "npm run build && node --env-file-if-exists=.env scripts/check-interaction-web-search-live.mjs",
    "check:context:redis:live": "npm run build && node scripts/check-context-redis-live.mjs",
    "example:worker:redis": "npm run build && node --env-file-if-exists=.env examples/worker/context-redis.ts",
    "example:worker:sql": "npm run build && node --env-file-if-exists=.env examples/worker/memory-sql.ts",
    "example:worker:milvus": "npm run build && node --env-file-if-exists=.env examples/worker/memory-milvus.ts",
    "example:runtime": "npm run build && node examples/runtime/graph-loop.ts",
    "example:runtime:placement": "npm run build && node examples/runtime/placement.ts",
    "example:worker:context-retrieval": "npm run build && node examples/worker/context-retrieval.ts",
    "example:runtime:quickstart": "npm run build && node examples/runtime/quickstart.ts",
    "example:runtime:api": "npm run build && node examples/runtime/api.ts",
    "example:runtime:flows": "npm run build && node examples/runtime/flows.ts"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  }
}
