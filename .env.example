# Shared credentials and deployment bindings for every Worker.
# Non-secret behavior (timeouts, budgets, strategy depth, provider options): ditto.yaml.
# 所有 Worker 共用这一份配置；显式调用 loadRuntimeConfigFile("ditto.yaml", process.env)。
# Node 24: node --env-file=.env ... ; live checks: npm run check:infer:live
# Copy to .env (Git ignored). Never put real credentials in this example.
DITTO_ENV=development
DITTO_WORKSPACE=.

# Comma-separated provider names. Enable only providers whose credentials you set.
# 这里只启用实际配置了凭证的供应商；各 Worker 通过 ctx.services.providers 复用。
DITTO_PROVIDERS=deepseek
DITTO_MODEL_PROVIDER=deepseek
DITTO_MODEL=deepseek-flash

# OpenAI-compatible DeepSeek. The token-limit field is a provider capability.
DITTO_PROVIDER_DEEPSEEK_KIND=openai-compatible
DITTO_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
DITTO_PROVIDER_DEEPSEEK_API_KEY=
DITTO_PROVIDER_DEEPSEEK_MODEL=deepseek-flash

DITTO_PROVIDER_OPENAI_KIND=openai-compatible
DITTO_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
DITTO_PROVIDER_OPENAI_API_KEY=
DITTO_PROVIDER_OPENAI_MODEL=gpt-4o-mini

# 智谱 / Zhipu: set a model available to your account.
DITTO_PROVIDER_GLM_KIND=openai-compatible
DITTO_PROVIDER_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DITTO_PROVIDER_GLM_API_KEY=
DITTO_PROVIDER_GLM_MODEL=glm-4.7-flash

DITTO_PROVIDER_CLAUDE_KIND=anthropic
DITTO_PROVIDER_CLAUDE_BASE_URL=https://api.anthropic.com/v1
DITTO_PROVIDER_CLAUDE_API_KEY=
DITTO_PROVIDER_CLAUDE_MODEL=

DITTO_PROVIDER_GEMINI_KIND=gemini
DITTO_PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DITTO_PROVIDER_GEMINI_API_KEY=
DITTO_PROVIDER_GEMINI_MODEL=

DITTO_PROVIDER_LOCAL_KIND=openai-compatible
DITTO_PROVIDER_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DITTO_PROVIDER_LOCAL_API_KEY=
DITTO_PROVIDER_LOCAL_MODEL=

# Shared Sandbox: exact names/origins, comma-separated; empty means deny.
# 启用新供应商时一并添加 origin，不要将 API Key 放在 URL 中。
DITTO_ALLOW_NETWORK=https://api.deepseek.com
DITTO_ALLOW_TOOLS=
DITTO_ALLOW_MCP=
DITTO_ALLOW_SKILLS=
DITTO_ALLOW_READ=false
DITTO_ALLOW_WRITE=false
# Requires an application-supplied SandboxExecutor (container/OS isolation).
DITTO_ALLOW_EXECUTE=false

# Explicit HTTP Worker bootstrap configuration; never part of Graph input.
DITTO_WORKER_TOKEN=
# Storage-specific options belong to the Worker that actually consumes them;
# no unused DATABASE_URL/REDIS_URL settings are invented here.
