# Load explicitly with Node 24: node --env-file=.env ...
# 使用 Node 24 显式加载：node --env-file=.env ...
DITTO_ENV=development
DITTO_WORKSPACE=.
DITTO_TIMEOUT_MS=30000
DITTO_MAX_TURNS=8

# Select a provider/model when using Agent model Nodes.
# 使用 Agent 模型 Node 时选择 Provider 和模型。
DITTO_PROVIDERS=
DITTO_MODEL_PROVIDER=
DITTO_MODEL=

# To use a real model, set DITTO_PROVIDERS=primary,claude,local
# 接入真实模型时，设置 DITTO_PROVIDERS=primary,claude,local
# and select one configured provider plus an available model identifier.
# 并选择一个已配置的 Provider 和可用模型 ID。
DITTO_PROVIDER_PRIMARY_KIND=openai-compatible
DITTO_PROVIDER_PRIMARY_BASE_URL=https://api.openai.com/v1
DITTO_PROVIDER_PRIMARY_API_KEY=
DITTO_PROVIDER_CLAUDE_KIND=anthropic
DITTO_PROVIDER_CLAUDE_BASE_URL=https://api.anthropic.com/v1
DITTO_PROVIDER_CLAUDE_API_KEY=
DITTO_PROVIDER_LOCAL_KIND=openai-compatible
DITTO_PROVIDER_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DITTO_PROVIDER_LOCAL_API_KEY=

# Exact names/origins, comma separated. Empty means deny; * explicitly allows all.
# 精确名称或 URL origin，以逗号分隔。留空表示拒绝；* 表示允许全部。
DITTO_ALLOW_NETWORK=
DITTO_ALLOW_TOOLS=
DITTO_ALLOW_MCP=
DITTO_ALLOW_SKILLS=
DITTO_ALLOW_READ=false
DITTO_ALLOW_WRITE=false
# Also requires an application-supplied SandboxExecutor (container/OS isolation).
# 还需要应用提供 SandboxExecutor（容器或操作系统隔离）。
DITTO_ALLOW_EXECUTE=false

# Used explicitly by your Worker HTTP server/client bootstrap; never in Graph input.
# 由 Worker HTTP 服务端/客户端启动代码显式使用，不放入 Graph 输入。
DITTO_WORKER_TOKEN=
