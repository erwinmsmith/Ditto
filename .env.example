# Credentials and deployment bindings, grouped by owner.
# 行为参数在 ditto.yaml；此文件仅存放凭证、地址、模型选择及部署权限。
# Node 24: node --env-file=.env ...; loadRuntimeConfigFile("ditto.yaml", process.env).
# Copy to .env (Git ignored). Never put real credentials in this example.

# Runtime / 应用运行环境
DITTO_RUNTIME_ENV=development
DITTO_RUNTIME_WORKSPACE=.

# Shared / 模型供应商（所有 Worker 复用）
DITTO_SHARED_PROVIDERS=deepseek

# DEEPSEEK
DITTO_SHARED_PROVIDER_DEEPSEEK_KIND=openai-compatible
DITTO_SHARED_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
DITTO_SHARED_PROVIDER_DEEPSEEK_API_KEY=
DITTO_SHARED_PROVIDER_DEEPSEEK_MODEL=deepseek-flash

# OPENAI
DITTO_SHARED_PROVIDER_OPENAI_KIND=openai-compatible
DITTO_SHARED_PROVIDER_OPENAI_BASE_URL=https://api.openai.com/v1
DITTO_SHARED_PROVIDER_OPENAI_API_KEY=
DITTO_SHARED_PROVIDER_OPENAI_MODEL=gpt-4o-mini

# GLM
DITTO_SHARED_PROVIDER_GLM_KIND=openai-compatible
DITTO_SHARED_PROVIDER_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
DITTO_SHARED_PROVIDER_GLM_API_KEY=
DITTO_SHARED_PROVIDER_GLM_MODEL=glm-4.7-flash

# CLAUDE
DITTO_SHARED_PROVIDER_CLAUDE_KIND=anthropic
DITTO_SHARED_PROVIDER_CLAUDE_BASE_URL=https://api.anthropic.com/v1
DITTO_SHARED_PROVIDER_CLAUDE_API_KEY=
DITTO_SHARED_PROVIDER_CLAUDE_MODEL=

# GEMINI
DITTO_SHARED_PROVIDER_GEMINI_KIND=gemini
DITTO_SHARED_PROVIDER_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DITTO_SHARED_PROVIDER_GEMINI_API_KEY=
DITTO_SHARED_PROVIDER_GEMINI_MODEL=

# LOCAL
DITTO_SHARED_PROVIDER_LOCAL_KIND=openai-compatible
DITTO_SHARED_PROVIDER_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
DITTO_SHARED_PROVIDER_LOCAL_API_KEY=
DITTO_SHARED_PROVIDER_LOCAL_MODEL=

# Shared / Sandbox 部署权限（空值表示禁止）
DITTO_SHARED_SANDBOX_ALLOW_NETWORK=https://api.deepseek.com
DITTO_SHARED_SANDBOX_ALLOW_TOOLS=
DITTO_SHARED_SANDBOX_ALLOW_MCP=
DITTO_SHARED_SANDBOX_ALLOW_SKILLS=
DITTO_SHARED_SANDBOX_ALLOW_READ=false
DITTO_SHARED_SANDBOX_ALLOW_WRITE=false
DITTO_SHARED_SANDBOX_ALLOW_EXECUTE=false

# Workers / INFER 默认模型
DITTO_WORKER_INFER_MODEL_PROVIDER=deepseek
DITTO_WORKER_INFER_MODEL=deepseek-flash

# Workers / RETRIEVAL 可选 embedding（仅显式调用 embeddingConfigFromEnv 时读取）
# 允许网络的 origin 也需加入 DITTO_SHARED_SANDBOX_ALLOW_NETWORK。
DITTO_WORKER_RETRIEVAL_EMBEDDING_BASE_URL=https://api.openai.com/v1
DITTO_WORKER_RETRIEVAL_EMBEDDING_API_KEY=
DITTO_WORKER_RETRIEVAL_EMBEDDING_MODEL=text-embedding-3-small

# Transport / HTTP Worker 通信认证
DITTO_TRANSPORT_HTTP_WORKER_TOKEN=

# Only add configuration for Workers that consume it; no empty placeholder sections.
